PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://127.0.0.1:5173
JWT_SECRET=replace-with-a-private-random-secret-at-least-16-characters
MONGODB_URI=

# Optional: enables GIF and sticker search through GIPHY.
# Keep this key on the backend only; never add it to frontend code.
GIPHY_API_KEY=
# Beta keys are rate-limited; default cap is 90 requests per hour.
GIPHY_MAX_REQUESTS_PER_HOUR=90
